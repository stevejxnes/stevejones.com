<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Steve Jones — Multimedia Creative</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Playfair+Display:ital,wght@0,400;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0a0a08;
      --bg2: #111110;
      --bg3: #161614;
      --surface: #1c1c1a;
      --border: rgba(255,255,255,0.07);
      --border-hover: rgba(255,255,255,0.18);
      --text: #f0ede6;
      --muted: #8a8880;
      --accent: #c9a86c;
      --accent2: #e8d5b0;
      --serif: 'Playfair Display', Georgia, serif;
      --sans: 'DM Sans', system-ui, sans-serif;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--sans);
      font-size: 16px;
      line-height: 1.6;
      font-weight: 300;
      cursor: none;
      overflow-x: hidden;
    }

    /* CUSTOM CURSOR */
    .cursor {
      width: 10px; height: 10px;
      background: var(--accent);
      border-radius: 50%;
      position: fixed; top: 0; left: 0;
      pointer-events: none;
      z-index: 9999;
      transition: transform 0.15s ease, width 0.2s ease, height 0.2s ease, background 0.2s ease;
      transform: translate(-50%, -50%);
    }
    .cursor-ring {
      width: 36px; height: 36px;
      border: 1px solid rgba(201,168,108,0.5);
      border-radius: 50%;
      position: fixed; top: 0; left: 0;
      pointer-events: none;
      z-index: 9998;
      transition: transform 0.08s linear;
      transform: translate(-50%, -50%);
    }
    body:has(a:hover) .cursor, body:has(button:hover) .cursor { transform: translate(-50%,-50%) scale(2.5); background: var(--accent2); }
    body:has(.work-item:hover) .cursor { transform: translate(-50%,-50%) scale(0.3); }

    /* NAV */
    nav {
      position: fixed; top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 1.5rem 3rem;
      background: transparent;
      transition: background 0.4s ease, backdrop-filter 0.4s ease;
    }
    nav.scrolled {
      background: rgba(10,10,8,0.88);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }
    .nav-logo {
      font-family: var(--serif);
      font-size: 1.1rem;
      letter-spacing: 0.04em;
      color: var(--text);
      text-decoration: none;
    }
    .nav-logo span { color: var(--accent); }
    .nav-links { display: flex; gap: 2.5rem; list-style: none; }
    .nav-links a {
      color: var(--muted); font-size: 0.8rem;
      text-decoration: none; letter-spacing: 0.12em; text-transform: uppercase;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--text); }

    /* HERO */
    #hero {
      min-height: 100vh;
      display: flex; flex-direction: column; justify-content: flex-end;
      padding: 0 3rem 5rem;
      position: relative;
      overflow: hidden;
    }
    .hero-bg {
      position: absolute; inset: 0;
      background: radial-gradient(ellipse 80% 60% at 60% 40%, #1a1610 0%, #0a0a08 70%);
    }
    .hero-grid-lines {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(to right, rgba(255,255,255,0.025) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255,255,255,0.025) 1px, transparent 1px);
      background-size: 80px 80px;
      mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 80%);
    }
    .hero-num {
      font-family: var(--serif);
      font-size: clamp(12rem, 22vw, 22rem);
      font-weight: 700;
      line-height: 0.8;
      color: transparent;
      -webkit-text-stroke: 1px rgba(201,168,108,0.12);
      position: absolute;
      right: -2rem; bottom: -3rem;
      pointer-events: none;
      user-select: none;
    }
    .hero-eyebrow {
      font-size: 0.72rem; letter-spacing: 0.25em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 1.2rem;
      position: relative;
      display: flex; align-items: center; gap: 1rem;
    }
    .hero-eyebrow::before {
      content: ''; display: block; width: 2rem; height: 1px; background: var(--accent);
    }
    .hero-title {
      font-family: var(--serif);
      font-size: clamp(3.5rem, 8vw, 7.5rem);
      font-weight: 400; line-height: 0.95;
      position: relative; max-width: 800px;
    }
    .hero-title em { font-style: italic; color: var(--accent); }
    .hero-sub {
      margin-top: 2rem; font-size: 1rem; color: var(--muted);
      max-width: 420px; line-height: 1.8; position: relative;
    }
    .hero-actions {
      margin-top: 2.5rem; display: flex; gap: 1.5rem; align-items: center; position: relative;
    }
    .btn-primary {
      display: inline-block; padding: 0.85rem 2.2rem;
      background: var(--accent); color: #0a0a08;
      font-family: var(--sans); font-size: 0.78rem;
      letter-spacing: 0.12em; text-transform: uppercase;
      text-decoration: none; font-weight: 500;
      transition: background 0.2s, transform 0.2s;
    }
    .btn-primary:hover { background: var(--accent2); transform: translateY(-2px); }
    .btn-ghost {
      display: inline-block; padding: 0.85rem 2.2rem;
      border: 1px solid var(--border-hover); color: var(--text);
      font-family: var(--sans); font-size: 0.78rem;
      letter-spacing: 0.12em; text-transform: uppercase;
      text-decoration: none; font-weight: 400;
      transition: border-color 0.2s, transform 0.2s;
    }
    .btn-ghost:hover { border-color: var(--accent); transform: translateY(-2px); }

    /* SCROLL INDICATOR */
    .scroll-hint {
      position: absolute; right: 3rem; bottom: 5rem;
      display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
      color: var(--muted); font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase;
    }
    .scroll-line {
      width: 1px; height: 60px; background: linear-gradient(to bottom, var(--accent), transparent);
      animation: scrollLine 1.8s ease-in-out infinite;
    }
    @keyframes scrollLine { 0%,100%{opacity:1;transform:scaleY(1)} 50%{opacity:0.3;transform:scaleY(0.4)} }

    /* SECTION COMMON */
    section { padding: 7rem 3rem; }
    .section-label {
      font-size: 0.68rem; letter-spacing: 0.28em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 1rem;
      display: flex; align-items: center; gap: 0.8rem;
    }
    .section-label::after { content:''; display:block; width:2rem; height:1px; background:var(--accent); }
    .section-title {
      font-family: var(--serif);
      font-size: clamp(2.2rem, 5vw, 4rem);
      font-weight: 400; line-height: 1.1; margin-bottom: 1rem;
    }
    .section-title em { font-style: italic; color: var(--accent); }

    /* ABOUT */
    #about { background: var(--bg2); }
    .about-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 6rem;
      align-items: center; margin-top: 4rem;
    }
    .about-image-wrap {
      position: relative;
    }
    .about-image-frame {
      width: 100%; aspect-ratio: 3/4;
      background: var(--surface);
      border: 1px solid var(--border);
      position: relative;
      overflow: hidden;
    }
    .about-image-frame::after {
      content: 'SJ';
      font-family: var(--serif);
      font-size: 6rem; color: rgba(201,168,108,0.12);
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
    }
    .about-accent-line {
      position: absolute; top: 1.5rem; left: 1.5rem; right: -1.5rem; bottom: -1.5rem;
      border: 1px solid rgba(201,168,108,0.2);
      pointer-events: none;
    }
    .about-stats {
      display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 2.5rem;
    }
    .stat {
      border-top: 1px solid var(--border);
      padding-top: 1.2rem;
    }
    .stat-num {
      font-family: var(--serif); font-size: 2.5rem;
      font-weight: 700; color: var(--accent); line-height: 1;
    }
    .stat-label { font-size: 0.75rem; color: var(--muted); letter-spacing: 0.08em; margin-top: 0.3rem; }
    .about-text { color: var(--muted); line-height: 1.9; font-size: 1rem; }
    .about-text p + p { margin-top: 1.2rem; }

    /* DISCIPLINES */
    #disciplines { background: var(--bg); }
    .disciplines-intro { max-width: 560px; color: var(--muted); margin-top: 1rem; line-height: 1.8; }
    .disciplines-grid {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
      margin-top: 4rem; border: 1px solid var(--border);
    }
    .discipline-card {
      padding: 2.5rem 2rem;
      border-right: 1px solid var(--border);
      position: relative; overflow: hidden;
      transition: background 0.3s;
      cursor: none;
    }
    .discipline-card:last-child { border-right: none; }
    .discipline-card:hover { background: var(--surface); }
    .discipline-card::before {
      content: attr(data-num);
      font-family: var(--serif); font-size: 5rem; font-weight: 700;
      color: rgba(201,168,108,0.06);
      position: absolute; top: -1rem; right: 1rem;
      line-height: 1; pointer-events: none;
      transition: color 0.3s;
    }
    .discipline-card:hover::before { color: rgba(201,168,108,0.14); }
    .discipline-icon {
      width: 44px; height: 44px; margin-bottom: 2rem;
      border: 1px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      transition: border-color 0.3s;
    }
    .discipline-card:hover .discipline-icon { border-color: var(--accent); }
    .discipline-icon svg { width: 20px; height: 20px; stroke: var(--accent); fill: none; stroke-width: 1.5; }
    .discipline-name {
      font-family: var(--serif); font-size: 1.25rem; margin-bottom: 0.8rem;
    }
    .discipline-desc { font-size: 0.85rem; color: var(--muted); line-height: 1.7; }
    .discipline-link {
      display: inline-flex; align-items: center; gap: 0.5rem;
      margin-top: 1.5rem; font-size: 0.72rem; letter-spacing: 0.15em;
      text-transform: uppercase; color: var(--accent);
      text-decoration: none; transition: gap 0.2s;
    }
    .discipline-link:hover { gap: 0.8rem; }
    .discipline-link svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; }

    /* WORK */
    #work { background: var(--bg2); }
    .work-filter {
      display: flex; gap: 1.5rem; margin-top: 3rem; flex-wrap: wrap;
    }
    .filter-btn {
      font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase;
      color: var(--muted); background: none; border: none;
      padding: 0.5rem 0; cursor: none;
      border-bottom: 1px solid transparent;
      transition: color 0.2s, border-color 0.2s;
    }
    .filter-btn.active, .filter-btn:hover { color: var(--text); border-bottom-color: var(--accent); }
    .work-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 1.5px; margin-top: 2rem;
    }
    .work-item {
      position: relative; overflow: hidden; cursor: none;
      aspect-ratio: 4/3; background: var(--surface);
    }
    .work-item.large { grid-column: span 2; }
    .work-item.tall { grid-row: span 2; aspect-ratio: auto; }
    .work-thumb {
      width: 100%; height: 100%;
      background: var(--surface);
      display: flex; align-items: center; justify-content: center;
      transition: transform 0.6s cubic-bezier(0.25,0.46,0.45,0.94);
      position: relative; overflow: hidden;
    }
    .work-item:hover .work-thumb { transform: scale(1.06); }
    .work-thumb-label {
      font-family: var(--serif); font-size: 2rem; color: rgba(201,168,108,0.1);
    }
    .work-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(10,10,8,0.92) 0%, rgba(10,10,8,0.2) 60%, transparent 100%);
      opacity: 0; transition: opacity 0.4s;
      display: flex; flex-direction: column; justify-content: flex-end;
      padding: 1.5rem;
    }
    .work-item:hover .work-overlay { opacity: 1; }
    .work-cat {
      font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 0.4rem;
    }
    .work-title { font-family: var(--serif); font-size: 1.1rem; }

    /* Different bg colors for placeholder thumbnails */
    .thumb-1 { background: #141210; }
    .thumb-2 { background: #0e1214; }
    .thumb-3 { background: #12140e; }
    .thumb-4 { background: #140e12; }
    .thumb-5 { background: #0e1412; }
    .thumb-6 { background: #14100e; }
    .thumb-7 { background: #10120e; }

    .placeholder-icon { opacity: 0.15; }
    .placeholder-icon svg { width: 48px; height: 48px; stroke: var(--accent); fill: none; stroke-width: 1; }

    /* REEL */
    #reel {
      background: var(--bg);
      text-align: center;
      padding: 7rem 3rem;
    }
    .reel-container {
      margin-top: 4rem; position: relative;
      border: 1px solid var(--border); max-width: 900px; margin-inline: auto;
      aspect-ratio: 16/9;
      display: flex; align-items: center; justify-content: center;
      background: var(--bg3); overflow: hidden;
    }
    .reel-lines {
      position: absolute; inset: 0;
      background-image: repeating-linear-gradient(
        0deg, transparent, transparent 2px, rgba(255,255,255,0.012) 2px, rgba(255,255,255,0.012) 4px
      );
    }
    .reel-play {
      width: 80px; height: 80px; border-radius: 50%;
      border: 1px solid rgba(201,168,108,0.4);
      display: flex; align-items: center; justify-content: center;
      cursor: none; position: relative; z-index: 1;
      transition: border-color 0.3s, transform 0.3s;
    }
    .reel-play:hover { border-color: var(--accent); transform: scale(1.08); }
    .reel-play svg { width: 28px; height: 28px; fill: var(--accent); margin-left: 4px; }
    .reel-label {
      position: absolute; bottom: 1.5rem; left: 1.5rem;
      font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted);
    }

    /* PROCESS */
    #process { background: var(--bg2); }
    .process-grid {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 0; margin-top: 4rem; border: 1px solid var(--border);
    }
    .process-step {
      padding: 2.5rem 2rem; border-right: 1px solid var(--border); position: relative;
    }
    .process-step:last-child { border-right: none; }
    .process-num {
      font-family: var(--serif); font-size: 0.85rem; color: var(--accent);
      margin-bottom: 1.5rem; letter-spacing: 0.1em;
    }
    .process-step-title {
      font-family: var(--serif); font-size: 1.15rem; margin-bottom: 0.7rem;
    }
    .process-step-desc { font-size: 0.85rem; color: var(--muted); line-height: 1.7; }
    .process-arrow {
      position: absolute; right: -0.85rem; top: 50%;
      transform: translateY(-50%);
      width: 16px; height: 16px;
      background: var(--bg2); border: 1px solid var(--border);
      border-left: none; border-bottom: none;
      transform: translateY(-50%) rotate(45deg);
      z-index: 2;
    }
    .process-step:last-child .process-arrow { display: none; }

    /* CLIENTS */
    #clients { background: var(--bg); padding: 5rem 3rem; }
    .clients-strip {
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 2rem; margin-top: 3rem;
      border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
      padding: 2.5rem 0;
    }
    .client-name {
      font-family: var(--serif); font-size: 1.1rem;
      color: rgba(240,237,230,0.2);
      transition: color 0.3s;
    }
    .client-name:hover { color: var(--text); }

    /* CONTACT */
    #contact {
      background: var(--bg2); min-height: 70vh;
      display: flex; align-items: center;
      padding: 7rem 3rem;
    }
    .contact-inner { max-width: 700px; }
    .contact-big {
      font-family: var(--serif);
      font-size: clamp(3rem, 7vw, 6rem);
      font-weight: 400; line-height: 1;
      margin-bottom: 2rem;
    }
    .contact-big em { font-style: italic; color: var(--accent); display: block; }
    .contact-desc { color: var(--muted); max-width: 400px; line-height: 1.8; margin-bottom: 3rem; }
    .contact-email {
      display: block; font-family: var(--serif); font-size: 1.1rem;
      color: var(--text); text-decoration: none; border-bottom: 1px solid var(--border);
      padding-bottom: 0.8rem; margin-bottom: 2.5rem;
      transition: border-color 0.2s, color 0.2s; width: fit-content;
    }
    .contact-email:hover { color: var(--accent); border-color: var(--accent); }
    .contact-socials { display: flex; gap: 1.5rem; }
    .social-link {
      font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--muted); text-decoration: none; transition: color 0.2s;
    }
    .social-link:hover { color: var(--accent); }

    /* FOOTER */
    footer {
      background: var(--bg); border-top: 1px solid var(--border);
      padding: 2rem 3rem;
      display: flex; align-items: center; justify-content: space-between;
    }
    .footer-copy { font-size: 0.75rem; color: var(--muted); }
    .footer-logo { font-family: var(--serif); font-size: 1rem; color: var(--muted); }
    .footer-logo span { color: var(--accent); }

    /* ANIMATIONS */
    .fade-up {
      opacity: 0; transform: translateY(24px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .fade-up.visible { opacity: 1; transform: none; }

    @media (max-width: 900px) {
      nav { padding: 1.2rem 1.5rem; }
      .nav-links { gap: 1.5rem; }
      #hero { padding: 0 1.5rem 4rem; }
      section { padding: 5rem 1.5rem; }
      .about-grid { grid-template-columns: 1fr; gap: 3rem; }
      .disciplines-grid { grid-template-columns: repeat(2, 1fr); }
      .discipline-card { border-right: none; border-bottom: 1px solid var(--border); }
      .work-grid { grid-template-columns: 1fr 1fr; }
      .work-item.large { grid-column: span 2; }
      .process-grid { grid-template-columns: repeat(2, 1fr); }
      .process-step { border-bottom: 1px solid var(--border); }
    }

    @media (max-width: 600px) {
      body { cursor: auto; }
      .cursor, .cursor-ring { display: none; }
      .disciplines-grid, .work-grid, .process-grid { grid-template-columns: 1fr; }
      .work-item.large { grid-column: span 1; }
      .hero-num { display: none; }
      nav { padding: 1rem; }
      nav .nav-links { display: none; }
    }
  </style>
</head>
<body>

  <!-- Cursor -->
  <div class="cursor" id="cursor"></div>
  <div class="cursor-ring" id="cursorRing"></div>

  <!-- NAV -->
  <nav id="nav">
    <a href="#hero" class="nav-logo">Steve<span>.</span></a>
    <ul class="nav-links">
      <li><a href="#about">About</a></li>
      <li><a href="#disciplines">Work</a></li>
      <li><a href="#work">Portfolio</a></li>
      <li><a href="#reel">Showreel</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </nav>

  <!-- HERO -->
  <section id="hero">
    <div class="hero-bg"></div>
    <div class="hero-grid-lines"></div>
    <div class="hero-num">SJ</div>

    <div class="hero-eyebrow">Multimedia Creative</div>
    <h1 class="hero-title">
      Steve<br /><em>Jones</em>
    </h1>
    <p class="hero-sub">
      Photographer. Filmmaker. Designer. Crafting visual narratives that live between frames and pixels.
    </p>
    <div class="hero-actions">
      <a href="#work" class="btn-primary">View Portfolio</a>
      <a href="#contact" class="btn-ghost">Get in Touch</a>
    </div>

    <div class="scroll-hint">
      <div class="scroll-line"></div>
      Scroll
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about">
    <div class="section-label">About Me</div>
    <div class="about-grid">
      <div class="about-image-wrap">
        <div class="about-image-frame">
          <img src="images/DSC03681.jpg" style="width:60%;height:100%;object-fit:cover;" />
        </div>
        <div class="about-accent-line"></div>
      </div>
      <div>
        <h2 class="section-title">Vision<br />through <em>every</em><br />medium</h2>
        <div class="about-text fade-up">
          <p>I'm Steve Jones — a London-based multimedia creative with over a decade of experience transforming ideas into unforgettable visual experiences.</p>
          <p>From the quiet tension of a portrait to the kinetic energy of a brand film, I move fluidly between disciplines to tell the stories that matter. My work lives at the intersection of artistry and intention.</p>
          <p>Whether you're a brand, agency, or fellow creator — I bring the same obsessive attention to light, composition, and narrative to every project.</p>
        </div>
        <div class="about-stats fade-up">
          <div class="stat">
            <div class="stat-num">10+</div>
            <div class="stat-label">Years of Experience</div>
          </div>
          <div class="stat">
            <div class="stat-num">180+</div>
            <div class="stat-label">Projects Delivered</div>
          </div>
          <div class="stat">
            <div class="stat-num">40+</div>
            <div class="stat-label">Clients Worldwide</div>
          </div>
          <div class="stat">
            <div class="stat-num">12</div>
            <div class="stat-label">Awards & Recognitions</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DISCIPLINES -->
  <section id="disciplines">
    <div class="section-label">Disciplines</div>
    <h2 class="section-title">What I <em>create</em></h2>
